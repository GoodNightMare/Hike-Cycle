@using HikeCycle.Mvc.Models
@model CartViewModel

@{
    var totalItems = Model.CartItems?.Count() ?? 0;
}

<div class="max-w-4xl mx-auto p-10">
    <h1 class="text-3xl font-black mb-8 flex items-center gap-3">
        <i class="fa-solid fa-basket-shopping"></i> ตะกร้าสินค้า
        @if (totalItems > 0)
        {
            <span class="text-lg font-bold text-gray-500 bg-gray-100 rounded-full px-3 py-1">@totalItems ชิ้น</span>
        }
    </h1>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50" role="alert">
            <span class="font-medium">Error!</span> @TempData["ErrorMessage"]
        </div>
    }

    @if (Model.CartItems == null || !Model.CartItems.Any())
    {
        <div class="py-20 text-center border-2 border-dashed rounded-3xl bg-gray-50">
            <p class="text-gray-400 text-lg">ไม่มีสินค้าในตะกร้า</p>
        </div>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var group in Model.CartItems.Where(i => !i.IsFree).GroupBy(item => new
            {
                item.ProductId,
                item.Size,
                item.StartDate,
                item.EndDate
            }))
            {
                var item = group.First();
                int quantity = group.Count();
                var start = DateTime.Parse(item.StartDate);
                var end = DateTime.Parse(item.EndDate);
                int totalDays = (end - start).Days;
                if (totalDays <= 0) totalDays = 1;
                decimal itemTotal = item.PricePerDay * totalDays * quantity;

                <div class="flex items-center gap-6 p-6 bg-white border rounded-2xl shadow-sm">
                    <div class="w-24 h-24 flex-shrink-0 bg-gray-100 rounded-xl overflow-hidden">
                        <img src="@item.ImageUrl" class="w-full h-full object-cover" />
                    </div>
                    <div class="flex-grow">
                        <h3 class="font-bold text-xl text-gray-800">@item.ProductName</h3>
                        @if (item.Category?.ToLower() == "shoes" && !string.IsNullOrEmpty(item.Size))
                        {
                            <p><span class="bg-gray-100 px-2 py-0.5 rounded text-xs font-bold text-black">SIZE: @item.Size</span>
                            </p>
                        }

                        <form asp-controller="Cart" asp-action="UpdateDate" method="post"
                              class="date-update-form text-sm text-gray-500 mt-1 space-y-1">
                            <input type="hidden" name="id" value="@item.Id" />
                            <div class="flex items-center gap-2">
                                <i class="fa-regular fa-calendar-days"></i>
                                <input type="date" name="startDate" value="@start.ToString("yyyy-MM-dd")"
                                       class="input input-bordered input-xs start-date" />
                                <span>-</span>
                                <input type="date" name="endDate" value="@end.ToString("yyyy-MM-dd")"
                                       class="input input-bordered input-xs end-date" />
                                <button type="submit" class="hidden">Update</button>
                            </div>
                            <p>(@totalDays วัน)</p>
                        </form>
                    </div>
                    <div class="flex items-center gap-4">
                        <form asp-controller="Cart" asp-action="DecreaseQuantity" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-circle btn-outline">-</button>
                        </form>
                        <span>@quantity</span>
                        <form asp-controller="Cart" asp-action="IncreaseQuantity" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-sm btn-circle btn-outline">+</button>
                        </form>
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-gray-400 uppercase">รวมของชิ้นนี้</p>
                        <p class="font-black text-2xl text-gray-900">฿@itemTotal.ToString("F2")</p>
                        <p class="text-[10px] text-gray-400">(฿@item.PricePerDay.ToString("F2") / วัน)</p>
                    </div>
                </div>
            }

            @foreach (var item in Model.CartItems.Where(i => i.IsFree))
            {
                <div class="flex items-center gap-6 p-6 bg-white border rounded-2xl shadow-sm">
                    <div class="w-24 h-24 flex-shrink-0 bg-gray-100 rounded-xl overflow-hidden">
                        <img src="@item.ImageUrl" class="w-full h-full object-cover" />
                    </div>
                    <div class="flex-grow">
                        <h3 class="font-bold text-xl text-gray-800">@item.ProductName</h3>
                    </div>
                    <div class="text-right">
                        <p class="font-black text-2xl text-green-600">FREE</p>
                    </div>
                    <div class="ml-4 w-[40px]"></div> <!-- Placeholder -->
                </div>
            }
        </div>

        <div class="mt-8 p-6 bg-gray-50 rounded-2xl">
            <h2 class="text-xl font-bold mb-4">ส่วนลดและโปรโมชั่น</h2>
            <form asp-controller="Cart" asp-action="Index" method="get" id="promotion-form">

                <div class="flex items-center mb-4">
                    <input type="checkbox" id="isStudent" name="isStudent" value="true" @(Model.IsStudent ? "checked" : "")
                           onchange="this.form.submit()"
                           class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <label for="isStudent" class="ml-2 block text-sm text-gray-900">
                        ฉันเป็นนักเรียน/นักศึกษา
                    </label>
                </div>

                <div class="space-y-2">
                    <label class="flex items-center p-3 rounded-lg border cursor-pointer @(Model.SelectedPromotionId == null ? "bg-white border-indigo-500" : "bg-gray-100 hover:bg-white")">
                        <input type="radio" name="selectedPromotionId" value="" @(Model.SelectedPromotionId == null ? "checked" : "") onchange="this.form.submit()" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500">
                        <span class="ml-3 text-sm font-semibold text-gray-900">ไม่ใช้โปรโมชั่น</span>
                    </label>

                    @foreach (var promo in Model.Promotions)
                    {
                        var isStudentPromo = promo.Title == "Student Explorer";
                        var disabled = isStudentPromo && !Model.IsStudent;
                        <label class="flex items-center p-3 rounded-lg border @(disabled ? "bg-gray-200" : "bg-gray-100 hover:bg-white") @(Model.SelectedPromotionId == promo.Id ? "bg-white border-indigo-500" : "") @(disabled ? "cursor-not-allowed" : "cursor-pointer")">
                            <input type="radio" name="selectedPromotionId" value="@promo.Id" @(Model.SelectedPromotionId == promo.Id ? "checked" : "") onchange="this.form.submit()" class="h-4 w-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" @(disabled ? "disabled" : "")>
                            <span class="ml-3 text-sm @(disabled ? "text-gray-400" : "text-gray-900")">
                                <span class="font-bold">@promo.Title</span>
                                @if (!string.IsNullOrEmpty(promo.Description))
                                {
                                    <p class="text-xs">@promo.Description</p>
                                }
                            </span>
                        </label>
                    }
                </div>
            </form>
    
            @if (Model.CalculationResult.AppliedPromotions.Any())
            {
                <div class="mt-4 space-y-2">
                    <h3 class="font-semibold">โปรโมชั่นที่ใช้:</h3>
                    @foreach (var promo in Model.CalculationResult.AppliedPromotions)
                    {
                        <div class="p-3 bg-green-100 rounded-lg">
                            <p class="font-bold text-green-800 text-sm">@promo.Title</p>
                            <p class="text-green-700 text-xs">@promo.Description</p>
                        </div>
                    }
                </div>
            }
            @if (Model.AvailableVouchers != null && Model.AvailableVouchers.Any())
            {
                <div class="mt-8">
                    <h2 class="text-2xl font-black mb-4 flex items-center gap-2 text-amber-800">
                        <i class="fa-solid fa-ticket"></i> Voucher
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        @foreach (var v in Model.AvailableVouchers)
                        {
                            <label class="relative flex items-center gap-4 p-5 bg-white border-2 border-gray-100 rounded-2xl cursor-pointer hover:border-amber-400 transition shadow-sm group"
                                id="label-voucher-@v.Id">
                                
                                <input type="radio" name="selectedVoucher" value="@v.Amount" 
                                    data-code="@v.Code"
                                    class="w-6 h-6 text-amber-600 focus:ring-amber-500 border-gray-300"
                                    onchange="applyVoucher(@v.Id, @v.Amount, '@v.Code')">
                                
                                <div class="flex-grow">
                                    <div class="flex items-center gap-2">
                                        <span class="font-black text-lg text-gray-900 uppercase tracking-tight">@v.Code</span>
                                    </div>
                                    <p class="text-sm text-amber-600 font-black">ลดเพิ่ม ฿@v.Amount.ToString("N0")</p>
                                </div>
                            </label>
                        }
                    </div>
                
                </div>
            }
        </div>

        <div class="mt-8 p-8 bg-white border-2 border-gray-100 rounded-3xl shadow-sm">
            <h2 class="text-2xl font-black mb-6 flex items-center gap-2">
                <i class="fa-solid fa-truck-fast text-red-500"></i> วิธีการจัดส่ง
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                <label class="relative flex flex-col p-4 border-2 rounded-2xl cursor-pointer hover:bg-gray-50 transition"
                       id="label-shop">
                    <input type="radio" name="addrType" value="Shop"
                           class="absolute top-4 right-4 w-4 h-4 text-black focus:ring-black" checked
                           onchange="updateCartAddr('Shop')">
                    <i class="fa-solid fa-store text-xl mb-2 text-gray-400"></i>
                    <span class="font-bold text-gray-800">รับที่ร้าน</span>
                    <span class="text-[10px] text-gray-400 uppercase font-black"></span>
                </label>

                <label class="relative flex flex-col p-4 border-2 rounded-2xl cursor-pointer hover:bg-gray-50 transition"
                       id="label-profile">
                    <input type="radio" name="addrType" value="Profile"
                           class="absolute top-4 right-4 w-4 h-4 text-black focus:ring-black"
                           onchange="updateCartAddr('Profile')">
                    <i class="fa-solid fa-house-user text-xl mb-2 text-gray-400"></i>
                    <span class="font-bold text-gray-800">ที่อยู่ในโปรไฟล์</span>
                    <span class="text-[10px] text-gray-400 uppercase font-black"></span>
                </label>

                <label class="relative flex flex-col p-4 border-2 rounded-2xl cursor-pointer hover:bg-gray-50 transition"
                       id="label-custom">
                    <input type="radio" name="addrType" value="Custom"
                           class="absolute top-4 right-4 w-4 h-4 text-black focus:ring-black"
                           onchange="updateCartAddr('Custom')">
                    <i class="fa-solid fa-pen-to-square text-xl mb-2 text-gray-400"></i>
                    <span class="font-bold text-gray-800">ระบุที่อยู่</span>
                    <span class="text-[10px] text-gray-400 uppercase font-black">กรอกที่อยู่</span>
                </label>
            </div>

            <div id="cartAddrSection" class="hidden animate-in fade-in slide-in-from-top-2 duration-300">
                <textarea id="displayShippingAddress" rows="3"
                          class="w-full border-2 border-gray-100 p-4 rounded-2xl text-sm focus:border-black outline-none bg-gray-50 transition-all"
                          placeholder="กรุณาระบุที่อยู่จัดส่งโดยละเอียด..."></textarea>
            </div>
        </div>

        <div class="mt-12 bg-gray-50 p-8 rounded-3xl flex flex-col md:flex-row justify-between items-center gap-6">
            <a href="/Products" class="text-gray-600 font-bold hover:underline order-2 md:order-1">
                <i class="fa-solid fa-arrow-left mr-2"></i> เลือกสินค้าเพิ่ม
            </a>

            

            <div class="flex flex-col md:flex-row items-center gap-6 md:gap-12 order-1 md:order-2 w-full md:w-auto">
                <div class="text-center md:text-right">
                <p class="text-gray-500 text-sm">ราคารวม</p>
                <p class="text-xl font-bold text-gray-500 line-through">
                    ฿@Model.CalculationResult.OriginalTotal.ToString("F2")
                </p>

                <p class="text-gray-500 text-sm mt-2">ส่วนลดโปรโมชั่น</p>
                <p class="text-xl font-bold text-red-500">-฿@Model.CalculationResult.TotalDiscount.ToString("F2")</p>

                <div id="voucher-display" class="hidden animate-in fade-in duration-300">
                    <p class="text-amber-600 text-sm mt-2 font-black">
                        ส่วนลด Voucher (<span id="voucher-code-text"></span>)
                    </p>
                    <p class="text-xl font-bold text-amber-500">
                        -฿<span id="voucher-amount-text">0.00</span>
                    </p>
                </div>

                <p class="text-gray-500 text-sm uppercase tracking-widest mt-2">ยอดชำระรวมทั้งหมด</p>
                <p class="text-4xl font-black text-green-600">
                    ฿<span id="grand-total">@Model.CalculationResult.FinalTotal.ToString("F2")</span>
                </p>
            </div>
        
                    <form asp-controller="Payments" asp-action="Index" method="get" id="checkoutForm" onsubmit="return validateCheckout()">
                        <input type="hidden" name="originalTotal" value="@Model.CalculationResult.OriginalTotal" />
                        <input type="hidden" name="totalDiscount" value="@Model.CalculationResult.TotalDiscount" />
                        <input type="hidden" name="voucherCode" id="finalVoucherCode" value="" />
                        <input type="hidden" name="voucherDiscount" id="finalVoucherDiscount" value="0" />

                        <input type="hidden" name="totalItems" value="@totalItems" />

                        <input type="hidden" name="finalTotal" id="hiddenFinalTotal" value="@Model.CalculationResult.FinalTotal" />
        
                        <input type="hidden" name="shippingAddress" id="finalShippingAddress"
                               value="รับที่ร้าน (Self-Pickup)" />

                        <button type="submit"
                                class="w-full md:w-auto px-10 py-4 bg-black text-white rounded-2xl font-black text-lg hover:scale-105 transition shadow-lg flex items-center justify-center">
                            ชำระเงิน <i class="fa-solid fa-chevron-right ml-2"></i>
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const dateForms = document.querySelectorAll('.date-update-form');
                dateForms.forEach(form => {
                    const startDateInput = form.querySelector('.start-date');
                    const endDateInput = form.querySelector('.end-date');

                    function updateEndDateMin() {
                        endDateInput.min = startDateInput.value;
                        if (endDateInput.value <= startDateInput.value) {
                            let nextDate = new Date(startDateInput.value);
    
                            nextDate.setDate(nextDate.getDate() + 1);
    
                            endDateInput.value = nextDate.toISOString().split('T')[0];
                        }
                    }

                    console.log(startDateInput.value, endDateInput.value);

                    startDateInput.addEventListener('change', function () {
                        updateEndDateMin();
                        form.submit();
                    });

                    endDateInput.addEventListener('change', function () {
                        form.submit();
                    });

                    updateEndDateMin();
                });
            });


            const profileAddress = "@Html.Raw(ViewBag.UserAddress ?? "ไม่ได้ระบุที่อยู่จัดส่งในโปรไฟล์")";

            function updateCartAddr(type) {
                const section = document.getElementById('cartAddrSection');
                const displayInput = document.getElementById('displayShippingAddress');
                const hiddenInput = document.getElementById('finalShippingAddress');
    
                ['label-shop', 'label-profile', 'label-custom'].forEach(id => {
                    document.getElementById(id).classList.remove('border-black', 'bg-gray-50');
                    document.getElementById(id).classList.add('border-gray-100');
                });

                if (type === 'Shop') {
                    section.classList.add('hidden');
                    const shopVal = "รับที่ร้าน (Self-Pickup)";
                    hiddenInput.value = shopVal;
                    document.getElementById('label-shop').classList.add('border-black', 'bg-gray-50');
                }
                else if (type === 'Profile') {
                    section.classList.remove('hidden');
                    displayInput.value = profileAddress;
                    displayInput.readOnly = true;
                    displayInput.classList.add('bg-gray-100');
                    hiddenInput.value = profileAddress;
                    document.getElementById('label-profile').classList.add('border-black', 'bg-gray-50');
                }
                else if (type === 'Custom') {
                    section.classList.remove('hidden');
                    displayInput.value = "";
                    displayInput.readOnly = false;
                    displayInput.classList.remove('bg-gray-100');
                    displayInput.focus();
                    hiddenInput.value = "";
                    document.getElementById('label-custom').classList.add('border-black', 'bg-gray-50');
                }
            }

            function validateCheckout() {
                const finalAddr = document.getElementById('finalShippingAddress').value.trim();
            
                const addrType = document.querySelector('input[name="addrType"]:checked').value;

                if (!finalAddr || finalAddr === "" || finalAddr === "ไม่ได้ระบุที่อยู่จัดส่งในโปรไฟล์") {
                    
                    let errorMsg = "";
                    if (addrType === 'Profile') {
                        errorMsg = "⚠️ โปรไฟล์ของคุณยังไม่ได้ระบุที่อยู่ กรุณาเลือก 'ระบุที่อยู่'";
                    } else if (addrType === 'Custom') {
                        errorMsg = "⚠️ กรุณากรอกที่อยู่สำหรับจัดส่งสินค้าด้วยครับ";
                    } else {
                        errorMsg = "⚠️ กรุณาระบุข้อมูลที่อยู่จัดส่งให้ครบถ้วน";
                    }

                    alert(errorMsg);
                    
                    if (addrType === 'Custom') {
                        document.getElementById('displayShippingAddress').focus();
                    }
                    
                    return false; 
                }

                return true; 
            }

document.getElementById('displayShippingAddress').addEventListener('input', function() {
    document.getElementById('finalShippingAddress').value = this.value;
});

const baseFinalTotal = parseFloat("@Model.CalculationResult.FinalTotal");

function applyVoucher(id, amount, code) {
    document.querySelectorAll('[id^="label-voucher-"]').forEach(el => {
        el.classList.remove('border-amber-400', 'bg-amber-50');
        el.classList.add('border-gray-100');
    });

    const activeLabel = document.getElementById('label-voucher-' + id);
    if (activeLabel) {
        activeLabel.classList.remove('border-gray-100');
        activeLabel.classList.add('border-amber-400', 'bg-amber-50');
    }

    const newTotal = Math.max(0, baseFinalTotal - amount);

    const grandTotalDisplay = document.getElementById('grand-total');
    if (grandTotalDisplay) {
        grandTotalDisplay.innerText = newTotal.toLocaleString(undefined, { minimumFractionDigits: 2 });
    }

    document.getElementById('finalVoucherCode').value = code;
    document.getElementById('finalVoucherDiscount').value = amount;
    document.getElementById('hiddenFinalTotal').value = newTotal;

    document.getElementById('voucher-display')?.classList.remove('hidden');
    document.getElementById('voucher-code-text').innerText = code;
    document.getElementById('voucher-amount-text').innerText = amount.toFixed(2);
    document.getElementById('btn-reset-voucher')?.classList.remove('hidden');
}

function resetVoucher() {
    document.querySelectorAll('input[name="selectedVoucher"]').forEach(input => input.checked = false);
    
    document.querySelectorAll('[id^="label-voucher-"]').forEach(el => {
        el.classList.remove('border-amber-400', 'bg-amber-50');
        el.classList.add('border-gray-100');
    });

    document.getElementById('grand-total').innerText = baseFinalTotal.toLocaleString(undefined, { minimumFractionDigits: 2 });
    document.getElementById('voucher-display')?.classList.add('hidden');
    document.getElementById('btn-reset-voucher')?.classList.add('hidden');
    
    document.getElementById('finalVoucherCode').value = "";
    document.getElementById('finalVoucherDiscount').value = "0";
    document.getElementById('hiddenFinalTotal').value = baseFinalTotal;
}

        </script>
    }