@using HikeCycle.Mvc.Models
@model List<HikeCycle.Mvc.Models.CartSessionItem>

<div class="max-w-4xl mx-auto p-10">
    <h1 class="text-3xl font-black mb-8 flex items-center gap-3">
        <i class="fa-solid fa-basket-shopping"></i> ตะกร้าสินค้า
    </h1>

    @if (Model == null || !Model.Any())
    {
        <div class="py-20 text-center border-2 border-dashed rounded-3xl bg-gray-50">
            <p class="text-gray-400 text-lg">ไม่มีสินค้าในตะกร้า</p>
            @* <a href="/Products" class="mt-4 inline-block bg-black text-white px-8 py-2 rounded-xl">เลือกสินค้าเลย</a> *@
        </div>
    }
    else
    {
    decimal grandTotal = 0; // สร้างตัวแปรเก็บราคารวมทั้งหมด

    <div class="space-y-6">
        @foreach (var item in Model)
        {
            // คำนวณจำนวนวัน (แปลง string เป็น DateTime)
            var start = DateTime.Parse(item.StartDate);
            var end = DateTime.Parse(item.EndDate);
            int totalDays = (end - start).Days;
            if (totalDays <= 0) totalDays = 1; // ขั้นต่ำ 1 วัน

            var itemTotal = item.PricePerDay * totalDays;
            grandTotal += itemTotal; // สะสมราคารวม

            <div class="flex items-center gap-6 p-6 bg-white border rounded-2xl shadow-sm">
                @* 1. รูปสินค้า *@
                <div class="w-24 h-24 flex-shrink-0 bg-gray-100 rounded-xl overflow-hidden">
                    <img src="@item.ImageUrl" class="w-full h-full object-cover" />
                </div>

                @* 2. รายละเอียด *@
                <div class="flex-grow">
                    <h3 class="font-bold text-xl text-gray-800">@item.ProductName</h3>
                    <div class="text-sm text-gray-500 mt-1 space-y-1">
                        @if (item.Category?.ToLower() == "shoes" && !string.IsNullOrEmpty(item.Size))
                        {
                            <p><span class="bg-gray-100 px-2 py-0.5 rounded text-xs font-bold text-black">SIZE: @item.Size</span></p>
                        }
                        <p class="flex items-center gap-2">
                            <i class="fa-regular fa-calendar-days"></i>
                            <span>@item.StartDate - @item.EndDate (@totalDays วัน)</span>
                        </p>
                    </div>
                </div>

                @* 3. ราคาต่อรายการ *@
                <div class="text-right">
                    <p class="text-xs text-gray-400 uppercase">รวมของชิ้นนี้</p>
                    <p class="font-black text-2xl text-gray-900">฿@itemTotal.ToString("N0")</p>
                    <p class="text-[10px] text-gray-400">(฿@item.PricePerDay.ToString("N0") / วัน)</p>
                </div>
            </div>
        }
    </div>
    
    @* --- ส่วนราคารวมทั้งหมดที่เพิ่มเข้ามา --- *@
    <div class="mt-12 bg-gray-50 p-8 rounded-3xl flex flex-col md:flex-row justify-between items-center gap-6">
        <a href="/Products" class="text-gray-600 font-bold hover:underline order-2 md:order-1">
            <i class="fa-solid fa-arrow-left mr-2"></i> เลือกสินค้าเพิ่ม
        </a>

        <div class="flex flex-col md:flex-row items-center gap-6 md:gap-12 order-1 md:order-2 w-full md:w-auto">
            <div class="text-center md:text-right">
                <p class="text-gray-500 text-sm uppercase tracking-widest">ยอดชำระรวมทั้งหมด</p>
                <p class="text-4xl font-black text-green-600">฿@grandTotal.ToString("N0")</p>
            </div>
            
            <button onclick="alert('Processing payment...')" class="w-full md:w-auto px-10 py-4 bg-black text-white rounded-2xl font-black text-lg hover:scale-105 transition shadow-lg flex items-center justify-center">
                ชำระเงิน <i class="fa-solid fa-chevron-right ml-2"></i>
            </button>
        </div>
    </div>
}
</div>