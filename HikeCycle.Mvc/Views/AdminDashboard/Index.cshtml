@model IEnumerable<HikeCycle.Mvc.Models.db.Reviews>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "แผงควบคุมหลัก";
}

<div class="space-y-8">
    <div>
        <h1 class="text-3xl font-black text-gray-900">Dashboard</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-5">
            <div class="w-14 h-14 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="fa-solid fa-boxes-stacked"></i>
            </div>
            <div>
                <p class="text-sm text-gray-500 font-bold uppercase tracking-wider">สินค้าทั้งหมด</p>
                <h3 class="text-3xl font-black">@ViewBag.TotalProducts</h3>
            </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-5">
            <div class="w-14 h-14 bg-yellow-50 text-yellow-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <div>
                <p class="text-sm text-gray-500 font-bold uppercase tracking-wider">สต็อกต่ำกว่า 5</p>
                <h3 class="text-3xl font-black text-yellow-600">@ViewBag.LowStock</h3>
            </div>
        </div>
        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-5">
            <div class="w-14 h-14 bg-red-50 text-red-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
                <p class="text-sm text-gray-500 font-bold uppercase tracking-wider">สต็อกหมด</p>
                <h3 class="text-3xl font-black text-red-600">@ViewBag.OutOfStock</h3>
            </div>
        </div>


        <div class="bg-white p-6 rounded-3xl border border-gray-100 shadow-sm flex items-center gap-5">
            <div class="w-14 h-14 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center text-2xl">
                <i class="fa-solid fa-star"></i>
            </div>
            <div>
                <p class="text-sm text-gray-500 font-bold uppercase tracking-wider">รีวิวจากลูกค้า</p>
                <h3 class="text-3xl font-black">@ViewBag.TotalReviews</h3>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-8">
        <div class="chart-container" style="position: relative; height:40vh; width:100%;">
            <h3 class="text-lg font-black text-gray-900 uppercase tracking-tight">รายได้รวม (7 วันล่าสุด)</h3>
            <canvas id="revenueChart"></canvas>
        </div>

        <div class="chart-container" style="position: relative; height:300px; width:100%; margin-top: 20px;">
            <h3 class="text-lg font-black text-gray-900 uppercase tracking-tight">จำนวนการจอง (7 วันล่าสุด)</h3>
            <canvas id="bookingChart"></canvas>
        </div>
        <div class="mt-8 bg-white p-8 rounded-3xl border border-gray-100 shadow-sm">
            <div class="flex justify-between items-center mb-6">
                <h3 class="text-lg font-black text-gray-900 uppercase tracking-tight">5 อันดับสินค้าเช่ายอดฮิต</h3>
                <span class="text-[10px] font-bold bg-amber-50 text-amber-600 px-3 py-1 rounded-full uppercase">Most
                    Rented</span>
                </div>
                <div style="position: relative; height:350px; width:100%;">
                    <canvas id="topProductsChart"></canvas>
                </div>
            </div>
        </div>


        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
            <script>
                const labels = @Html.Raw(Json.Serialize(ViewBag.ChartLabels));
                const revenues = @Html.Raw(Json.Serialize(ViewBag.ChartRevenues));
                const counts = @Html.Raw(Json.Serialize(ViewBag.ChartCounts));

                new Chart(document.getElementById('revenueChart'), {
                type: 'line',
                data: {
                labels: labels,
                datasets: [{
                label: 'รายได้ (บาท)',
                data: revenues,
                borderColor: '#10b981', 
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                borderWidth: 4,
                pointBackgroundColor: '#fff',
                pointBorderWidth: 2,
                fill: true,
                tension: 0.4
                }]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                y: { beginAtZero: true, grid: { display: false } },
                x: { grid: { display: false } }
                }
                }
                });

                new Chart(document.getElementById('bookingChart'), {
                type: 'bar',
                data: {
                labels: labels,
                datasets: [{
                label: 'จำนวนการจอง',
                data: counts,
                backgroundColor: '#3b82f6', 
                borderRadius: 10,
                }]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { display: false } },
                x: { grid: { display: false } }
                }
                }
                });

                const topNames = @Html.Raw(Json.Serialize(ViewBag.TopProductNames));
                const topCounts = @Html.Raw(Json.Serialize(ViewBag.TopProductCounts));

                new Chart(document.getElementById('topProductsChart'), {
                type: 'bar',
                data: {
                labels: topNames,
                datasets: [{
                label: 'จำนวนชิ้นที่ถูกเช่า',
                data: topCounts,
                backgroundColor: [
                '#8b5cf6', 
                '#3b82f6', 
                '#10b981', 
                '#f59e0b', 
                '#ef4444'  
                ],
                borderRadius: 12, 
                barThickness: 40  
                }]
                },
                options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                legend: { display: false } 
                },
                scales: {
                y: {
                beginAtZero: true,
                ticks: { stepSize: 1 },
                grid: { display: false }
                },
                x: {
                grid: { display: false },
                ticks: {
                callback: function (value) {
                const label = this.getLabelForValue(value);
                return label.length > 15 ? label.substr(0, 15) + '...' : label;
                },
                font: { size: 11, weight: '600' }
                }
                }
                }
                }
                });
            </script>
        }