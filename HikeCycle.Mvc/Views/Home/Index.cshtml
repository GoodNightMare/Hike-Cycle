@model HikeCycle.Models.HomeViewModel
@{
    ViewData["Title"] = "หน้าแรก";
}

<div class="min-h-screen">
    @* Banner Section *@
    <div class="relative h-96 mx-4 mt-4 rounded-xl overflow-hidden shadow-lg bg-gradient-to-r from-[#0B6623] to-green-600">
        <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-6">
            <h1 id="banner-text" class="text-3xl md:text-5xl font-bold text-white max-w-4xl leading-tight transition-all duration-500">
                @Model.Banners[0]
            </h1>
            <p class="mt-4 text-white/90 text-lg">เตรียมอุปกรณ์ให้พร้อม แล้วออกไปผจญภัยกับธรรมชาติ</p>
        </div>

        @* Indicators *@
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-3 z-20">
            @for (int i = 0; i < Model.Banners.Count; i++)
            {
                <span class="indicator-dot w-3 h-3 rounded-full cursor-pointer bg-white/40" onclick="setBanner(@i)"></span>
            }
        </div>
    </div>

    @* Route Recommend Section *@
    <div class="mt-10 px-4">
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            เส้นทางแนะนำ
            <span class="text-red-500">🔥</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
            @foreach (var route in Model.Routes)
            {
                <div class="bg-white rounded-xl p-5 shadow-sm border hover:shadow-lg transition">
                    <div class="flex justify-between items-start">
                        <h3 class="text-lg font-semibold">@route.Name</h3>
                        <span class="text-sm px-2 py-1 rounded bg-green-100 text-green-700">@route.Level</span>
                    </div>
                    <div class="mt-3 text-sm text-gray-600 space-y-1">
                        <p>📍 จังหวัด : @route.Province</p>
                        <p>🗺️ ระยะทาง : @route.Distance</p>
                        <p>⏱ ระยะเวลา : @route.Duration</p>
                    </div>
                    <p class="mt-3 text-sm">🌄 <b>ไฮไลต์:</b> @route.Highlight</p>
                    <p class="mt-2 text-sm">🎒 <b>เหมาะกับ:</b> @route.Suitable</p>
                </div>
            }
        </div>
    </div>
</div>

@* JavaScript สำหรับเลื่อน Banner เหมือนใน React *@
<script>
    const banners = @Html.Raw(Json.Serialize(Model.Banners));
    let current = 0;

    function updateUI() {
        document.getElementById('banner-text').innerText = banners[current];
        document.querySelectorAll('.indicator-dot').forEach((dot, index) => {
            dot.className = index === current ? "indicator-dot w-3 h-3 rounded-full cursor-pointer bg-white scale-125" : "indicator-dot w-3 h-3 rounded-full cursor-pointer bg-white/40";
        });
    }

    function setBanner(index) {
        current = index;
        updateUI();
    }

    if (banners.length > 1) {
        setInterval(() => {
            current = (current + 1) % banners.length;
            updateUI();
        }, 5000);
    }
    updateUI();
</script>