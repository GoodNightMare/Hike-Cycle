@using Microsoft.AspNetCore.Http
@using System.Text.Json
@using HikeCycle.Mvc.Models

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HikeCycle</title>
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <style>
        .main-color-bg-brown {
        background-color: #4A3728;
        }
    </style>
</head>

<body class="bg-gray-50">
    <header>
        <nav class="main-color-bg-brown text-white shadow-md h-36">
            <div class="container h-full m-auto flex justify-between items-center px-4 py-6">
                <a asp-controller="Home" asp-action="Index"
                       class="flex gap-4 items-center hover:text-green-200 transition">
                    <span class="text-5xl font-bold">Hike-Cycle</span>
                    <span class="text-m self-end hidden md:block">เช่าอุปกรณ์เดินป่า</span>
                </a>

                <div class="flex gap-8 text-lg">
                    <div class="flex flex-col items-center group">
                        <i class="fa-solid fa-tent text-3xl group-hover:scale-110 transition"></i>
                        <a asp-controller="Products" asp-action="Index" class="text-xl">สินค้า</a>
                    </div>

                    @{
                        var sessionData = Context.Session.GetString("UserCart");
                        int cartCount = 0;

                        if (!string.IsNullOrEmpty(sessionData))
                        {
                            var cart = JsonSerializer.Deserialize<List<CartSessionItem>>(sessionData);
                            cartCount = cart?.Count ?? 0;
                        }
                    }

                    <div class="flex flex-col items-center group mx-8">
                        <div class="relative">
                            <i class="fa-solid fa-cart-shopping text-3xl group-hover:scale-110 transition"></i>
                            @if (cartCount > 0)
                            {
                                <span id="cart-count"
                                      class="absolute -top-2 -right-3 bg-red-600 text-white rounded-full px-1.5 text-xs font-bold animate-pulse">
                                    @cartCount
                                </span>
                            }
                        </div>
                        <a asp-controller="Cart" asp-action="Index" class="text-lg">ตะกร้า</a>
                    </div>
@{
        var sessionName = Context.Session.GetString("UserName"); 
    }

@if (string.IsNullOrEmpty(sessionName))
    {
        <div class="flex flex-col items-center group">
            <i class="fa-solid fa-circle-user text-3xl group-hover:scale-110 transition"></i>
            <a asp-controller="Account" asp-action="Login" class="text-lg">เข้าสู่ระบบ</a>
        </div>
    }
    else
    {
        <div class="flex flex-col items-center group">
            <i class="fa-solid fa-user-gear text-3xl group-hover:scale-110 transition"></i>
            <a asp-controller="Account" asp-action="Profile" class="text-lg">โปรไฟล์</a>
        </div>
    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container mx-auto min-h-screen">
        <main role="main" class="py-6">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-t py-8 mt-10">
        <div class="container mx-auto px-4 text-center text-gray-500">
            &copy; 2026 - HikeCycle - <a asp-area="" asp-controller="Home" asp-action="Privacy"
                                         class="hover:underline">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>