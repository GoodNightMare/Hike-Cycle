@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole")?.ToLower();
    
    // Helper function สำหรับเช็ค Active Link
    string IsActive(string controller)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "bg-blue-600 text-white"
            : "text-gray-400 hover:bg-gray-800 hover:text-white";
    }
}

<aside class="w-64 md:w-72 bg-gray-900 text-white min-h-screen flex flex-col transition-all duration-300 shadow-xl">
    @* ส่วนหัว: Logo/System Name *@
    <div class="p-6 border-b border-gray-800">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-black tracking-tight">HikeCycle System</h1>
        </div>
    </div>

    @* ส่วนเมนู *@
    <nav class="flex-1 px-4 py-6 space-y-2">
        
        @* --- เมนูสำหรับ Admin --- *@
        @if (role == "admin")
        {
            <p class="px-2 text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Main Menu</p>
            
            <a asp-controller="AdminDashboard" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminDashboard")">
                <i class="fa-solid fa-chart-line w-5"></i>
                <span class="font-medium">Dashboard</span>
            </a>

            <a asp-controller="AdminOrders" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminOrders")">
                <i class="fa-solid fa-cart-shopping w-5"></i>
                <span class="font-medium">Orders</span>
            </a>

            <a asp-controller="AdminProducts" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminProducts")">
                <i class="fa-solid fa-boxes-stacked w-5"></i>
                <span class="font-medium">Products</span>
            </a>

            <a asp-controller="AdminUsers" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminUsers")">
                <i class="fa-solid fa-users-gear w-5"></i>
                <span class="font-medium">Users</span>
            </a>

            <div class="my-4 border-t border-gray-800"></div>

            <a asp-controller="AdminSettings" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminSettings")">
                <i class="fa-solid fa-gears w-5"></i>
                <span class="font-medium">Settings</span>
            </a>
        }
        
        @* --- เมนูสำหรับ Staff --- *@
        else if (role == "staff")
        {
            <p class="px-2 text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Staff Portal</p>
            
            <a asp-controller="AdminOrders" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminOrders")">
                <i class="fa-solid fa-cart-shopping w-5"></i>
                <span class="font-medium">Orders</span>
            </a>
        }
    </nav>

    @* ส่วนท้าย: Help Center หรือ Version *@
    <div class="p-4 bg-gray-950 border-t border-gray-800">
        <div class="flex items-center gap-3 text-xs text-gray-500">
            <i class="fa-solid fa-circle-info"></i>
            <span>Version 4.0.2</span>
        </div>
    </div>
</aside>