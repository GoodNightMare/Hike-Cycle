@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole")?.ToLower();
    
    string IsActive(string controller)
    {
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "bg-gray-700 text-white border-l-4 border-white shadow-inner"
        : "text-gray-500 hover:bg-gray-800/50 hover:text-gray-200 border-l-4 border-transparent";
    }
}

<aside class="w-64 md:w-72 bg-gray-900 text-white min-h-screen flex flex-col transition-all duration-300 shadow-xl">
    <div class="p-6 border-b border-gray-800">
        <div class="flex items-center gap-3">
            <h1 class="text-xl font-black tracking-tight">HikeCycle System</h1>
        </div>
    </div>

    <nav class="flex-1 px-4 py-6 space-y-2">
        
        @if (role == "admin")
        {
            <p class="px-2 text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Main Menu</p>
            
            <a asp-controller="AdminDashboard" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminDashboard")">
                <i class="fa-solid fa-chart-line w-5 text-blue-400"></i>
                <span class="font-medium">Dashboard</span>
            </a>

            <a asp-controller="AdminProducts" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminProducts")">
                <i class="fa-solid fa-boxes-stacked w-5 text-purple-400"></i>
                <span class="font-medium">Products</span>
            </a>

            <a asp-controller="AdminBookings" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminBookings")">
                <i class="fa-solid fa-calendar-check w-5 text-emerald-400"></i>
                <span class="font-medium">Bookings</span>
            </a>

            <a asp-controller="AdminReviews" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminReviews")">
                <i class="fa-solid fa-comment-dots w-5 text-yellow-400"></i>
                <span class="font-medium">Reviews</span>
            </a>

            <a asp-controller="AdminUsers" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminUsers")">
                <i class="fa-solid fa-users-gear w-5 text-cyan-400"></i>
                <span class="font-medium">Users</span>
            </a>

            <a asp-controller="AdminPromotions" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminPromotions")">
                <i class="fa-solid fa-tags w-5 text-orange-500"></i>
                <span class="font-medium">Promotions</span>
            </a>

            <a asp-controller="AdminRoutes" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminRoutes")">
                <i class="fa-solid fa-map-location-dot w-5 text-green-600"></i>
                <span class="font-medium">Routes</span>
            </a>
        }
        
        else if (role == "staff")
        {
            <p class="px-2 text-[10px] font-bold text-gray-500 uppercase tracking-widest mb-4">Main Menu</p>
            
            <a asp-controller="AdminProducts" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminProducts")">
                <i class="fa-solid fa-boxes-stacked w-5 text-purple-400"></i>
                <span class="font-medium">Products</span>
            </a>
            
            <a asp-controller="AdminBookings" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminBookings")">
                <i class="fa-solid fa-calendar-check w-5 text-emerald-400"></i>
                <span class="font-medium">Bookings</span>
            </a>

            <a asp-controller="AdminReviews" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminReviews")">
                <i class="fa-solid fa-comment-dots w-5 text-yellow-400"></i>
                <span class="font-medium">Reviews</span>
            </a>
            <a asp-controller="AdminPromotions" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminPromotions")">
                <i class="fa-solid fa-tags w-5 text-orange-500"></i>
                <span class="font-medium">Promotions</span>
            </a>

            <a asp-controller="AdminRoutes" asp-action="Index"
                   class="flex items-center gap-3 px-4 py-3 rounded-xl transition @IsActive("AdminRoutes")">
                <i class="fa-solid fa-map-location-dot w-5 text-green-600"></i>
                <span class="font-medium">Routes</span>
            </a>
        }
    </nav>

    <div class="p-4 bg-gray-950 border-t border-gray-800">
        <div class="flex items-center gap-3 text-xs text-gray-500">
            <i class="fa-solid fa-circle-info"></i>
            <span>Version 4.0.2</span>
        </div>
    </div>
</aside>