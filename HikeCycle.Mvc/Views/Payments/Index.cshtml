@model HikeCycle.Mvc.Models.PaymentViewModel
@{
    ViewData["Title"] = "Payment";
}

<div class="max-w-2xl mx-auto p-10">
    <h1 class="text-3xl font-black mb-8">Payment</h1>

    <div class="bg-gray-50 p-6 rounded-2xl mb-8">
        <h2 class="text-xl font-bold mb-4">สรุปยอดชำระ</h2>
        <div class="space-y-2">
            <div class="flex justify-between">
                <span class="text-gray-600">ราคารวม</span>
                <span class="font-semibold">฿@Model.OriginalTotal.ToString("N0")</span>
            </div>
            <div class="flex justify-between text-red-500">
                <span class="text-gray-600">ส่วนลด</span>
                <span class="font-semibold">-฿@Model.TotalDiscount.ToString("N0")</span>
            </div>
            <div class="flex justify-between font-black text-2xl text-green-600">
                <span>ยอดชำระรวมทั้งหมด</span>
                <span>฿@Model.Amount.ToString("N0")</span>
            </div>
        </div>
    </div>

    <form asp-controller="Payments" asp-action="Create" method="post">
        <input type="hidden" asp-for="BookingId" />
        <input type="hidden" asp-for="Amount" />
        <input type="hidden" asp-for="OriginalTotal" />
        <input type="hidden" asp-for="TotalDiscount" />

        <div class="space-y-6">
            <div>
                <label class="block text-sm font-medium text-gray-700">Payment Method</label>
                <div class="mt-2 space-y-2">
                    <div class="flex items-center">
                        <input id="method_bank" name="Method" type="radio" value="Bank" checked class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300">
                        <label for="method_bank" class="ml-3 block text-sm font-medium text-gray-700">Bank Transfer</label>
                    </div>
                    <div class="flex items-center">
                        <input id="method_promptpay" name="Method" type="radio" value="PromptPay" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300">
                        <label for="method_promptpay" class="ml-3 block text-sm font-medium text-gray-700">PromptPay</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-8">
            <button type="submit" class="w-full bg-black text-white rounded-2xl font-black text-lg hover:scale-105 transition shadow-lg flex items-center justify-center px-10 py-4">
                Confirm Payment
            </button>
        </div>
    </form>
</div>