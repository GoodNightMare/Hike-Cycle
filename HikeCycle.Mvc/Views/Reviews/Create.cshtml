@model HikeCycle.Mvc.Models.db.Reviews
@{
    var product = ViewBag.Product as HikeCycle.Mvc.Models.db.Product;
    ViewData["Title"] = "เขียนรีวิว - " + product.Name;
}

<div class="max-w-2xl mx-auto p-6 md:p-10">
    <div class="text-center mb-10">

        <h1 class="text-3xl font-black mb-2">ให้คะแนนความพึงพอใจ</h1>
        <div class="flex justify-center mb-6">
            <div class="w-32 h-32 md:w-40 md:h-40 rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white">
                @if (product.ProductImages != null && product.ProductImages.Any())
                {
                    <img src="@product.ProductImages.First().ImageUrl" 
                         alt="@product.Name" 
                         class="w-full h-full object-cover">
                }
                else
                {
                    <div class="w-full h-full bg-gray-100 flex items-center justify-center text-gray-300">
                        <i class="fa-solid fa-image text-4xl"></i>
                    </div>
                }
            </div>
        </div>


        <p class="text-gray-500 uppercase tracking-widest text-sm">@product.Name</p>
    </div>

    <form asp-action="Create" method="post"
          class="bg-white rounded-[2.5rem] shadow-2xl p-8 md:p-12 border border-gray-100">
        <input type="hidden" name="ProductId" value="@ViewBag.ProductId" />
        <input type="hidden" name="BookingId" value="@ViewBag.BookingId" />

        <div class="space-y-10">
            <div class="text-center">
                <label class="block text-gray-400 font-black uppercase text-xs mb-4">คุณภาพสินค้าและบริการ</label>
                <div class="flex flex-row-reverse justify-center gap-2 star-rating">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <input type="radio" id="star-@i" name="Rating" value="@i" class="hidden peer" required @(i == 5 ?
                                                                                                                                            "checked" : "") />
                    <label for="star-@i"
                           class="text-4xl md:text-5xl text-gray-200 cursor-pointer hover:text-yellow-400 peer-checked:text-yellow-400 peer-hover:text-yellow-400 transition-colors">
                        <i class="fa-solid fa-star"></i>
                    </label>
                }
            </div>
            <p id="rating-label" class="mt-4 font-bold text-gray-800 text-lg">ดีเยี่ยม!</p>
        </div>

        <div>
            <label asp-for="Comment"
                   class="block text-gray-400 font-black uppercase text-xs mb-3">บอกความรู้สึกของคุณ (ถ้ามี)</label>
            <textarea asp-for="Comment" rows="4"
                      class="w-full bg-gray-50 border-none rounded-2xl p-5 focus:ring-2 focus:ring-yellow-400 transition-all placeholder:text-gray-300 font-medium"
                      placeholder="แชร์ประสบการณ์การใช้งานเครื่องเดินป่าชิ้นนี้..."></textarea>
        </div>

        <div class="pt-4">
            <button type="submit"
                    class="w-full bg-black text-white py-5 rounded-2xl font-black text-lg hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl">
                ส่งรีวิว <i class="fa-solid fa-paper-plane ml-2"></i>
            </button>
            <a href="javascript:history.back()"
                   class="block text-center mt-6 text-gray-400 font-bold hover:text-black transition">
                ยกเลิกและย้อนกลับ
            </a>
        </div>
    </div>
</form>
</div>

@section Scripts {
    <script>
        const labels = {
            '5': 'ดีเยี่ยม!',
            '4': 'ดีมาก',
            '3': 'ปานกลาง',
            '2': 'พอใช้',
            '1': 'ควรปรับปรุง'
        };

        document.querySelectorAll('.star-rating input').forEach(radio => {
            radio.addEventListener('change', (e) => {
                document.getElementById('rating-label').innerText = labels[e.target.value];
            });
        });
    </script>
}

<style>
    /* CSS ช่วยให้ Hover ดาวแล้วดวงก่อนหน้าสว่างด้วย */
    .star-rating label:hover~label {
        color: #facc15 !important;
    }
</style>