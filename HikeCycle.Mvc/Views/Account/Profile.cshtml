@using HikeCycle.Mvc.Models.db
@model User
@{
    ViewData["Title"] = "โปรไฟล์ของฉัน";
    // เช็คชื่อคลาสในไฟล์ UserProfile.cs ของคุณว่ามี s ไหม ถ้ามีให้เติม s หลัง UserProfile ตรงนี้ครับ
    UserProfile? profile = ViewBag.Profile as UserProfile;
}

<div class="max-w-4xl mx-auto p-6 md:p-10">
    <div class="bg-white rounded-[2rem] shadow-2xl overflow-hidden border border-gray-100">
        
        @* Header Section *@
        <div class="main-color-bg-brown p-10 text-white relative">
            <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
                <div class="w-32 h-32 bg-white rounded-full flex items-center justify-center text-5xl text-gray-800 border-4 border-white/20 shadow-lg">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="text-center md:text-left">
                    @* แก้ไข: @( ต้องติดกัน *@
                    <h1 class="text-4xl font-black tracking-tight">@(profile?.FullName ?? "")</h1>
                    @* <p class="text-white/60 mt-1 font-medium">สมาชิกหมายเลข #@Model.Id</p> *@
                </div>
            </div>
        </div>

        @* Data Section *@
        <div class="p-10 grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="space-y-8">
                <h2 class="text-xl font-bold flex items-center gap-3 text-gray-800">บัญชี</h2>
                <div class="grid gap-6">
                    <div>
                        <label class="text-gray-400 uppercase font-black">อีเมล</label>
                        <p class="text-lg font-semibold text-gray-700">@Model.Email</p>
                    </div>
                    <div>
                        <label class="text-gray-400 uppercase font-black">เบอร์โทรศัพท์</label>
                        @* แก้ไข: @( ต้องติดกัน *@
                        <p class="text-lg font-semibold text-gray-700">@(profile?.Phone ?? "ยังไม่ได้ระบุ")</p>
                    </div>
                </div>
            </div>

            <div class="space-y-8">
                <div class="p-6 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                    @* แก้ไข: @( ต้องติดกัน *@
                                            <label class="text-gray-400 uppercase font-black">ที่อยู่</label>
                    <p class="text-gray-600 font-medium">@(profile?.Address ?? "ยังไม่ได้ระบุที่อยู่")</p>
                </div>
            </div>
        </div>

        <div class="px-10 py-8 bg-gray-50 border-t flex justify-end gap-4">
            <a asp-action="Logout" class="px-6 py-3 text-red-500 font-bold hover:underline">ออกจากระบบ</a>
            <button class="px-8 py-3 bg-black text-white rounded-2xl font-bold shadow-xl">แก้ไขข้อมูล</button>
        </div>
    </div>
</div>