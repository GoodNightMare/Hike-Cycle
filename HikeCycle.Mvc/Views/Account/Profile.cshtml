@using HikeCycle.Mvc.Models
@model AccountProfileViewModel
@{
    ViewData["Title"] = "โปรไฟล์ของฉัน";
}

<div id="editProfileModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>

    <div class="flex min-h-full items-center justify-center p-4">
        <div
            class="relative w-full max-w-lg transform overflow-hidden rounded-[2.5rem] bg-white p-10 shadow-2xl transition-all">
            
            <div class="text-center mb-8">
                <h3 class="text-3xl font-black text-gray-800">แก้ไขข้อมูลส่วนตัว</h3>
                <p class="text-gray-400 text-sm mt-2">อัปเดตข้อมูลการติดต่อของคุณ</p>
            </div>

            <form asp-action="UpdateProfile" asp-controller="Account" method="post" class="space-y-6">
                @* ข้อมูลที่อนุญาตให้แก้ *@
                <div>
                    <label
                    class="block text-gray-400 font-black uppercase text-[10px] tracking-widest mb-2 ml-1">ชื่อ-นามสกุล</label>
                    <input name="FullName" value="@Model.Profile?.FullName"
                           class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 focus:bg-white focus:border-yellow-400 focus:ring-0 transition-all font-bold text-gray-700 shadow-inner" />
                </div>

                <div>
                    <label
                    class="block text-gray-400 font-black uppercase text-[10px] tracking-widest mb-2 ml-1">เบอร์โทรศัพท์</label>
                    <input name="Phone" value="@Model.Profile?.Phone"
                           class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 focus:bg-white focus:border-yellow-400 focus:ring-0 transition-all font-bold text-gray-700 shadow-inner" />
                </div>

                <div>
                    <label
                    class="block text-gray-400 font-black uppercase text-[10px] tracking-widest mb-2 ml-1">ที่อยู่</label>
                    <textarea name="Address" rows="3"
                              class="w-full bg-gray-50 border-2 border-transparent rounded-2xl p-4 focus:bg-white focus:border-yellow-400 focus:ring-0 transition-all font-bold text-gray-700 shadow-inner">@Model.Profile?.Address</textarea>
                </div>

                <div class="flex gap-4 pt-4">
                    <button type="button" onclick="toggleModal()"
                            class="flex-1 px-6 py-4 bg-gray-100 text-gray-500 rounded-2xl font-black hover:bg-gray-200 transition-all">
                        ยกเลิก
                    </button>
                    <button type="submit"
                            class="flex-1 px-6 py-4 bg-black text-white rounded-2xl font-black shadow-lg hover:bg-gray-800 hover:-translate-y-1 active:scale-95 transition-all">
                        บันทึกข้อมูล
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto p-6 md:p-10">
    <div class="bg-white rounded-[2rem] shadow-2xl overflow-hidden border border-gray-100">

        @* Header Section *@
        <div class="main-color-bg-brown p-10 text-white relative">
            <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
                <div
                    class="w-32 h-32 bg-white rounded-full flex items-center justify-center text-5xl text-gray-800 border-4 border-white/20 shadow-lg">
                    <i class="fa-solid fa-user"></i>
                </div>
                <div class="text-center md:text-left">
                    <h1 class="text-4xl font-black tracking-tight">@(Model.Profile?.FullName ?? "")</h1>
                    <p class="text-white/60 mt-1 font-medium">สมาชิกหมายเลข #@Model.User.Id</p>
                </div>
            </div>
        </div>

        @* Data Section *@
        <div class="p-10 grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="space-y-8">
                <h2 class="text-xl font-bold flex items-center gap-3 text-gray-800">บัญชี</h2>
                <div class="grid gap-6">
                    <div>
                        <label class="text-gray-400 uppercase font-black">อีเมล</label>
                        <p class="text-lg font-semibold text-gray-700">@Model.User.Email</p>
                    </div>
                    <div>
                        <label class="text-gray-400 uppercase font-black">เบอร์โทรศัพท์</label>
                        <p class="text-lg font-semibold text-gray-700">@(Model.Profile?.Phone ?? "ยังไม่ได้ระบุ")</p>
                    </div>
                </div>
            </div>

            <div class="space-y-8">
                <div class="p-6 bg-gray-50 rounded-2xl border-2 border-dashed border-gray-200">
                    <label class="text-gray-400 uppercase font-black">ที่อยู่</label>
                    <p class="text-gray-600 font-medium">@(Model.Profile?.Address ?? "ยังไม่ได้ระบุที่อยู่")</p>
                </div>
            </div>
        </div>

        <div class="px-10 py-8 bg-gray-50 border-t flex justify-end gap-4">
            <a asp-action="Logout" class="px-6 py-3 text-red-500 font-bold hover:underline">ออกจากระบบ</a>
            @* เปลี่ยนจากปุ่มเดิม เป็นโค้ดชุดนี้ครับ *@
            <button onclick="toggleModal()"
                    class="px-8 py-3 bg-black text-white rounded-2xl font-bold shadow-xl hover:scale-105 transition-all">
                แก้ไขข้อมูล
            </button>
        </div>
    </div>

    @* Booking History Section *@
    <div class="mt-12">
        <h2 class="text-3xl font-black mb-8">ประวัติการเช่า</h2>

        @foreach (var booking in Model.AllBookings)
        {
            <div class="bg-white p-6 rounded-[2rem] shadow-xl border border-gray-100 mb-6">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <h4 class="font-black text-xl text-gray-800">Booking ID: #@booking.Id</h4>
                        <p class="text-sm font-medium text-gray-400">
                            <i class="fa-regular fa-calendar-days mr-1"></i>
                            @booking.StartDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("th-TH")) -
                            @booking.EndDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("th-TH"))
                        </p>
                    </div>
                    <div class="text-right">
                        <p class="font-black text-2xl text-gray-800">฿@booking.FinalAmount.ToString("N0")</p>
                        <span
                            class="inline-flex items-center px-4 py-1 rounded-full text-xs font-black uppercase tracking-widest 
                            @(booking.Status == "Completed" ? "bg-blue-100 text-blue-600" :
                                                                            booking.Status == "Confirmed" ? "bg-green-100 text-green-600" : "bg-gray-100 text-gray-500")">
                            @booking.Status
                        </span>
                    </div>
                </div>

                @* รายการสินค้าพร้อมปุ่มรีวิว *@
                <ul class="space-y-3">
                    @foreach (var item in booking.BookingItems)
                    {
                        <li
                            class="flex items-center justify-between p-4 bg-gray-50 rounded-2xl border border-transparent hover:border-yellow-400/50 transition-all group">
                            <div class="flex items-center gap-4">
                                @* ถ้าคุณมีรูปสินค้าใส่ตรงนี้ได้เลย *@
                                <div class="flex flex-col">
                                    <span class="font-bold text-gray-800 group-hover:text-black">@item.Product.Name</span>
                                    <div class="flex gap-2 items-center">
                                        @if (!string.IsNullOrEmpty(item.Size))
                                        {
                                            <span
                                                class="text-[10px] font-black bg-white px-2 py-0.5 rounded-md border text-gray-400">SIZE:
                                                @item.Size</span>
                                            }
                                            <span class="text-xs font-bold text-gray-400">จำนวน: @item.Quantity</span>
                                            <span class="text-xs text-gray-400">
                                               ที่อยู่การจัดส่ง: 
                                               <span class="text-sm text-gray-600">

                                               @(string.IsNullOrEmpty(booking.ShippingAddress) ? "ไม่มีข้อมูลที่อยู่" :
                                                                booking.ShippingAddress)
                                               </span>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                @* 🚩 เช็คเงื่อนไขการคืนของ *@
                                @if (booking.Returns != null && booking.Returns.Any())
                                {
                                    @* ตรวจสอบว่าใน Booking นี้ สินค้า ProductId นี้ถูกรีวิวไปแล้วหรือยัง *@
                                    var isReviewed = booking.Reviews?.Any(r => r.ProductId == item.ProductId) ?? false;

                                    @if (isReviewed)
                                    {
                                        @* ถ้ามีการรีวิวแล้ว -> โชว์สถานะว่ารีวิวแล้ว *@
                                        <span
                                            class="flex items-center gap-1 px-4 py-2 bg-green-50 text-green-600 rounded-xl font-black text-xs border border-green-100">
                                            <i class="fa-solid fa-check-circle"></i> รีวิวเรียบร้อยแล้ว
                                        </span>
                                    }
                                    else
                                    {
                                        @* ถ้ายังไม่รีวิว -> โชว์ปุ่มรีวิวสินค้า *@
                                        <a asp-controller="Reviews" asp-action="Create" asp-route-productId="@item.ProductId"
                                               asp-route-bookingId="@booking.Id"
                                               class="flex items-center gap-2 px-6 py-2 bg-yellow-400 text-yellow-900 rounded-xl font-black text-xs hover:scale-105 hover:shadow-lg transition-all active:scale-95">
                                            <i class="fa-solid fa-star"></i> รีวิวสินค้า
                                        </a>
                                    }
                                }
                                else
                                {
                                    @* ถ้ายังไม่ได้คืนของ *@
                                    <span class="text-[10px] font-black text-gray-300 bg-gray-100 px-3 py-1.5 rounded-lg uppercase">
                                        รอคืนของเพื่อรีวิว
                                    </span>
                                }
                            </li>
                        }
                    </ul>
        
                    <div class="mt-4 pt-4 border-t border-dashed flex justify-end">
                        <a asp-controller="Bookings" asp-action="Success" asp-route-id="@booking.Id"
                               class="text-xs font-bold text-gray-400 hover:text-black transition flex items-center gap-1">
                            ดูรายละเอียดใบจอง <i class="fa-solid fa-arrow-right text-[10px]"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <script>
        function toggleModal() {
            const modal = document.getElementById('editProfileModal');
            modal.classList.toggle('hidden');
        
            // ป้องกันการเลื่อนหน้าจอเมื่อ Modal เปิดอยู่
            if (!modal.classList.contains('hidden')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = 'auto';
            }
        }

        // ปิด Modal เมื่อคลิกพื้นหลัง (Backdrop)
        window.onclick = function (event) {
            const modal = document.getElementById('editProfileModal');
            if (event.target == modal) {
                toggleModal();
            }
        }
    </script>