@model IEnumerable<HikeCycle.Mvc.Models.db.Product>
@using System.Text.Encodings.Web
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "จัดการสินค้า";
}
<div class="">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-2xl font-black text-gray-900 uppercase tracking-tight">จัดการสินค้า</h1>
            <p class="text-sm text-gray-500">จัดการรายการอุปกรณ์และสินค้าทั้งหมด</p>
        </div>
        <button onclick="openCreateModal()"
                class="bg-black hover:bg-gray-800 text-white font-bold py-2.5 px-6 rounded-xl transition-all shadow-lg flex items-center gap-2">
            <i class="fa-solid fa-plus text-xs"></i> เพิ่มสินค้าใหม่
        </button>
    </div>

    <div class="bg-white border border-gray-100 rounded-2xl shadow-sm overflow-hidden">
        <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400 mt-4">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
                <tr>
                    <th class="py-4 px-6 font-bold text-gray-400 uppercase text-[10px]">Product</th>
                    <th class="py-4 px-6 font-bold text-gray-400 uppercase text-[10px]">Brand/Cat</th>
                    <th class="py-4 px-6 font-bold text-gray-400 uppercase text-[10px] text-center">Price/Day</th>
                    <th class="py-4 px-6 font-bold text-gray-400 uppercase text-[10px] text-center">Stock</th>
                    <th class="py-4 px-6 font-bold text-gray-400 uppercase text-[10px] text-center">Status</th>
                    <th class="py-4 px-6 font-bold text-gray-400 uppercase text-[10px] text-right">Actions</th>
                </tr>
            </thead>
            <tbody id="users-tbody" class="divide-y divide-gray-50">
                @foreach (var item in Model)
                {
                    var firstImg = item.ProductImages.FirstOrDefault()?.ImageUrl ?? "https://via.placeholder.com/150";
                    <tr data-id="@item.Id" class="group hover:bg-gray-50/50 transition-colors">
                        <td class="py-4 px-6 text-gray-400 font-mono">
                            <div class="flex items-center gap-3">
                                <img src="@firstImg"
                                     class="w-12 h-12 rounded-lg object-cover border border-gray-100 shadow-sm">
                                <div>
                                    <div class="font-bold text-gray-900">@item.Name</div>
                                    <div class="text-[10px] text-gray-400">ID: #@item.Id</div>
                                </div>
                            </div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="text-gray-700 font-medium">@item.Brand</div>
                            <div class="text-[10px] text-gray-400">@item.Category</div>
                        </td>
                        <td class="py-4 px-6 text-center font-bold text-gray-900">฿@item.PricePerDay?.ToString("N0")</td>
                        <td class="py-4 px-6 text-center text-gray-600 font-mono text-xs">@item.Stock</td>
                        <td class="py-4 px-6 text-center">
                            <span
                                class="px-2.5 py-1 rounded-lg text-[10px] font-black uppercase border @(item.Status == "Available" ? "bg-green-50 text-green-600 border-green-100" : "bg-red-50 text-red-600 border-red-100")">
                                @item.Status
                            </span>
                        </td>
                        <td class="py-4 px-6 text-right">
                            <div class="flex justify-end gap-2">
                                @* 🚩 แก้ไขปุ่ม View *@
                                <button type="button" onclick="viewProduct(@item.Id, 
                                    '@JavaScriptEncoder.Default.Encode(item.Name ?? "")', 
                                    '@item.Category', 
                                    '@item.Status', 
                                    '@item.Level', 
                                    '@JavaScriptEncoder.Default.Encode(item.Specs ?? "")', 
                                    '@JavaScriptEncoder.Default.Encode(item.SuitableFor ?? "")', 
                                    '@item.Variants', 
                                    '@JavaScriptEncoder.Default.Encode(item.Description ?? "")')"
                                        class="p-2 text-gray-400 hover:text-black hover:bg-white rounded-lg shadow-sm">
                                    <i class="fa-solid fa-eye"></i>
                                </button>

                                @* 🚩 แก้ไขปุ่ม Edit *@
                                <button type="button" onclick="editProduct(@item.Id, 
                                    '@JavaScriptEncoder.Default.Encode(item.Name ?? "")', 
                                    '@item.Brand', 
                                    '@item.Category', 
                                    @(item.PricePerDay ?? 0), 
                                    @(item.Stock ?? 0), 
                                    '@item.Status', 
                                    '@JavaScriptEncoder.Default.Encode(item.Description ?? "")', 
                                    '@item.Level', 
                                    '@JavaScriptEncoder.Default.Encode(item.Specs ?? "")', 
                                    '@JavaScriptEncoder.Default.Encode(item.SuitableFor ?? "")', 
                                    '@item.Variants')" class="p-2 text-blue-600 hover:bg-white rounded-lg shadow-sm">
                                    <i class="fa-solid fa-pen"></i>
                                </button>

                                <button onclick="deleteProduct(@item.Id)"
                                        class="p-2 text-red-600 hover:bg-white rounded-lg shadow-sm">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div id="view-modal" class="fixed inset-0 z-[110] hidden items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="hideViewModal()"></div>
    <div class="relative bg-white rounded-3xl shadow-2xl w-full max-w-3xl p-0 overflow-hidden">
        <div class="bg-gray-900 p-6 text-white flex justify-between items-center">
            <div>
                <h2 id="v-name" class="text-xl font-black uppercase tracking-tight"></h2>
                <p id="v-category" class="text-xs text-gray-400 uppercase tracking-widest"></p>
            </div>
            <button onclick="hideViewModal()" class="text-gray-400 hover:text-white"><i
                class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div class="p-8 max-h-[70vh] overflow-y-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="space-y-6">
                        <div>
                            <label
                                class="text-[10px] font-black text-blue-600 uppercase mb-2 block tracking-widest">Technical
                                Specs</label>
                                <p id="v-specs"
                                       class="text-sm text-gray-700 leading-relaxed bg-blue-50/50 p-4 rounded-xl border border-blue-100 italic">
                                </p>
                            </div>
                            <div>
                                <label
                                    class="text-[10px] font-black text-gray-400 uppercase mb-2 block tracking-widest">Suitable
                                    For</label>
                                    <p id="v-suitable" class="text-sm text-gray-600"></p>
                                </div>
                            </div>
                            <div class="space-y-6">
                                <div class="flex gap-4">
                                    <div class="flex-1">
                                        <label
                                        class="text-[10px] font-black text-gray-400 uppercase mb-1 block tracking-widest">Level</label>
                                        <span id="v-level"
                                              class="inline-block px-3 py-1 rounded-full text-[10px] font-black border uppercase"></span>
                                    </div>
                                    <div class="flex-1">
                                        <label
                                        class="text-[10px] font-black text-gray-400 uppercase mb-1 block tracking-widest">Status</label>
                                        <span id="v-status"
                                              class="inline-block px-3 py-1 rounded-full text-[10px] font-black border uppercase"></span>
                                    </div>
                                </div>
                                <div>
                                    <label
                                        class="text-[10px] font-black text-gray-400 uppercase mb-2 block tracking-widest">Available
                                        Variants</label>
                                        <div id="v-variants" class="flex flex-wrap gap-2"></div>
                                    </div>
                                    <div class="pt-4 border-t border-gray-100">
                                        <label
                                        class="text-[10px] font-black text-gray-400 uppercase mb-1 block tracking-widest">Description</label>
                                        <p id="v-desc" class="text-sm text-gray-500 leading-relaxed"></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="bg-gray-50 p-6 flex justify-end">
                            <button onclick="hideViewModal()"
                                    class="bg-black text-white px-8 py-2.5 rounded-xl font-bold shadow-lg hover:bg-gray-800 transition">Close</button>
                        </div>
                    </div>
                </div>

                <div id="product-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
                    <div class="fixed inset-0 bg-black/60 backdrop-blur-sm" onclick="hideProductModal()"></div>
                    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl p-8 max-h-[90vh] overflow-y-auto">
                        <h2 id="modal-title" class="text-xl font-black text-gray-900 uppercase mb-6 tracking-tight">เพิ่มสินค้า</h2>
                        <form id="product-form" method="post" asp-action="SaveProduct" class="grid grid-cols-2 gap-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Id" id="p-id" value="0">
            
                            <div class="col-span-2">
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Product Name</label>
                                <input type="text" name="Name" id="p-name"
                                       class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none focus:ring-1 focus:ring-black"
                                       required>
                            </div>
            
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Brand</label>
                                <input type="text" name="Brand" id="p-brand"
                                       class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Category</label>
                                <select name="Category" id="p-category" onchange="toggleVariants()"
                                        class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                                    <option value="tent">Tent</option>
                                    <option value="backpack">Backpack</option>
                                    <option value="shoes">Shoes</option>
                                    <option value="cooking">Cooking</option>
                                    <option value="lighting">Lighting</option>
                                    <option value="trekking_pole">Trekking_Pole</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-blue-600 uppercase mb-1">Price / Day</label>
                                <input type="number" name="PricePerDay" id="p-price"
                                       class="w-full px-4 py-2 border border-blue-100 rounded-xl outline-none focus:ring-1 focus:ring-blue-600">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-blue-600 uppercase mb-1">Stock Qty</label>
                                <input type="number" name="Stock" id="p-stock"
                                       class="w-full px-4 py-2 border border-blue-100 rounded-xl outline-none focus:ring-1 focus:ring-blue-600">
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Level</label>
                                <select name="Level" id="p-level"
                                        class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                                    <option value="เริ่มต้น">เริ่มต้น</option>
                                    <option value="ปานกลาง">ปานกลาง</option>
                                    <option value="เชี่ยวชาญ">เชี่ยวชาญ</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Status</label>
                                <select name="Status" id="p-status"
                                        class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                                    <option value="active">Active</option>
                                    <option value="inactive">InActive</option>
                                </select>
                            </div>

                            <div class="col-span-2">
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Specs ({"capacity":"50
                                    ลิตร"})</label>
                                    <input type="text" name="Specs" id="p-specs"
                                           class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                                </div>

                                <div class="col-span-2">
                                    <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Suitable
                                        For(["เดินป่า"])</label>
                                        <input type="text" name="SuitableFor" id="p-suitable"
                                               class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                                    </div>

                                    <div class="col-span-2" id="variants-container">
                                        <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">
                                            Variants ([{"size":36,"stock":5}])
                                        </label>
                                        <input type="text" name="Variants" id="p-variants"
                                               class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none">
                                    </div>

                                    <div class="col-span-2">
                                        <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Description</label>
                                        <textarea name="Description" id="p-desc" rows="3"
                                                  class="w-full px-4 py-2 border border-gray-200 rounded-xl outline-none"></textarea>
                                    </div>

                                    <div class="col-span-2 flex justify-end gap-3 mt-4">
                                        <button type="button" onclick="hideProductModal()"
                                                class="font-bold text-gray-400 px-4 hover:text-gray-900 transition">ยกเลิก</button>
                                        <button type="submit"
                                                class="bg-black text-white px-8 py-2.5 rounded-xl font-bold shadow-lg hover:bg-gray-800 transition">บันทึก</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        @section Scripts {
                            <script>
                                function showProductModal(title = "เพิ่มสินค้า") {
                                    $('#modal-title').text(title);
                                    $('#product-modal').removeClass('hidden').addClass('flex');
                                    $('body').addClass('overflow-hidden');
                                }

                                function toggleVariants() {
                                    const category = $('#p-category').val();
                                    const container = $('#variants-container');
                                    const input = $('#p-variants');

                                    // 🚩 ถ้าไม่ใช่ Shoes ให้ซ่อน และล้างค่าทิ้ง (เพื่อไม่ให้ส่ง JSON ผิดไปที่ DB)
                                    if (category !== 'shoes') {
                                        container.hide();
                                        input.val(''); // ล้างค่าทิ้งป้องกัน Error JSON
                                    } else {
                                        container.show();
                                    }
                                }

                                function openCreateModal() {
                                    // 1. เปลี่ยนหัวข้อ Modal
                                    $('#modal-title').text("เพิ่มสินค้าใหม่");
    
                                    // 2. ล้างข้อมูลใน Form ทั้งหมด
                                    $('#product-form')[0].reset();
    
                                    // 3. เซต ID เป็น 0 (เพื่อบอกว่าเป็นรายการใหม่)
                                    $('#p-id').val(0);

                                    toggleVariants()

                                    $('#product-form').attr('action', '/AdminProducts/SaveProduct');
    
                                    // 5. แสดง Modal
                                    $('#product-modal').removeClass('hidden').addClass('flex');
                                    $('body').addClass('overflow-hidden');
                                }

                                function hideProductModal() {
                                    $('#product-modal').addClass('hidden').removeClass('flex');
                                    $('body').removeClass('overflow-hidden');
                                    $('#product-form')[0].reset();
                                    $('#p-id').val(0);
                                }

                                // 🚩 ปรับปรุงให้รับฟิลด์ใหม่ๆ เข้ามาใส่ Form
                                function editProduct(id, name, brand, cat, price, stock, status, desc, level, specs, suitable, variants) {
                                    showProductModal("แก้ไขสินค้า");
                                    $('#p-id').val(id);
                                    $('#p-name').val(name);
                                    $('#p-brand').val(brand);
                                    $('#p-category').val(cat);
                                    $('#p-price').val(price);
                                    $('#p-stock').val(stock);
                                    $('#p-status').val(status);
                                    $('#p-desc').val(desc);
                                    $('#p-level').val(level || 'เริ่มต้น');
                                    $('#p-specs').val(specs);
                                    $('#p-suitable').val(suitable);
                                    $('#p-variants').val(variants);
                                    toggleVariants(); // 🚩 เช็คสถานะตามหมวดหมู่ของสินค้าที่แก้ไข
    
                                    $('#product-modal').removeClass('hidden').addClass('flex');
                                }

                                function deleteProduct(id) {
                                    if (confirm('ยืนยันการลบสินค้านี้?')) {
                                        $.post('@Url.Action("DeleteProduct")', { id: id }, function () {
                                            location.reload();
                                        });
                                    }
                                }

                                function viewProduct(id, name, cat, status, level, specs, suitable, variants, desc) {
                                    $('#v-name').text(name);
                                    $('#v-category').text(cat);
                                    $('#v-specs').text(specs || 'No technical specs provided.');
                                    $('#v-suitable').text(suitable || 'Not specified.');
                                    $('#v-desc').text(desc || 'No description available.');
            
                                    // UI Styling for Level
                                    const levelEl = $('#v-level');
                                    levelEl.text(level || 'Normal').removeClass().addClass(`inline-block px-3 py-1 rounded-full text-[10px] font-black border uppercase`);
                                    if (level === 'Hard') levelEl.addClass('bg-red-50 text-red-600 border-red-100');
                                    else if (level === 'Easy') levelEl.addClass('bg-green-50 text-green-600 border-green-100');
                                    else levelEl.addClass('bg-gray-100 text-gray-600 border-gray-200');

                                    // UI Styling for Status
                                    const statusEl = $('#v-status');
                                    statusEl.text(status).removeClass().addClass(`inline-block px-3 py-1 rounded-full text-[10px] font-black border uppercase`);
                                    if (status === 'Available') statusEl.addClass('bg-green-50 text-green-600 border-green-100');
                                    else statusEl.addClass('bg-orange-50 text-orange-600 border-orange-100');

                                    // Variant Badges
                                    const variantContainer = $('#v-variants');
                                    variantContainer.empty();
                                    if (variants && variants.trim() !== "") {
                                        try {
                                            // 🚩 ตรวจสอบว่าเป็น JSON หรือไม่
                                            const data = JSON.parse(variants);
            
                                            if (Array.isArray(data)) {
                                                data.forEach(v => {
                                                    // ออกแบบ Badge ใหม่ให้โชว์ทั้ง Size และ Stock
                                                    const badge = `
                                                                                                                                                                                                                                                        <div class="flex items-center bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
                                                                                                                                                                                                                                                            <span class="px-3 py-1 bg-gray-50 border-r border-gray-200 text-[10px] font-black text-gray-400 uppercase">Size</span>
                                                                                                                                                                                                                                                            <span class="px-3 py-1 text-xs font-bold text-gray-900">${v.size || v.Size || '-'}</span>
                                                                                                                                                                                                                                                            <span class="px-3 py-1 bg-blue-50 border-l border-gray-200 text-[10px] font-black text-blue-500 uppercase">Stock</span>
                                                                                                                                                                                                                                                            <span class="px-3 py-1 text-xs font-bold ${v.stock > 0 ? 'text-green-600' : 'text-red-400'}">${v.stock ?? 0}</span>
                                                                                                                                                                                                                                                        </div>`;
                                                    variantContainer.append(badge);
                                                });
                                            }
                                        } catch (e) {
                                            // 🚩 กรณีไม่ใช่ JSON (เป็นข้อความ S, M, L ธรรมดา) ให้ใช้แบบเดิม
                                            variants.split(',').forEach(v => {
                                                variantContainer.append(`<span class="px-3 py-1 bg-white border border-gray-200 text-gray-600 rounded-lg text-xs font-medium shadow-sm">${v.trim()}</span>`);
                                            });
                                        }
                                    } else {
                                        variantContainer.append('<span class="text-xs text-gray-400 italic">No variants.</span>');
                                    }

                                    $('#view-modal').removeClass('hidden').addClass('flex');
                                    $('body').addClass('overflow-hidden');

                                        
                                }

                                function hideViewModal() {
                                    $('#view-modal').addClass('hidden').removeClass('flex');
                                    $('body').removeClass('overflow-hidden');
                                }
                            </script>
                        }