@model IEnumerable<HikeCycle.Mvc.ViewModels.ProductIndexViewModel>

@{
    ViewData["Title"] = "สินค้าทั้งหมด";
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-gray-800">อุปกรณ์เช่าทั้งหมด</h1>

    <div class="bg-white rounded-2xl p-5 shadow-sm mb-8 border border-gray-100">
        <form asp-action="Index" method="get" class="flex flex-wrap gap-4 items-center">
        
            <div class="relative w-full sm:w-72">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                <input type="text" name="search" value="@Context.Request.Query["search"]" placeholder="ค้นหาสินค้า..."
                       class="w-full border border-gray-200 pl-10 pr-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4A3728]" />
            </div>

            <div class="flex items-center gap-2">
                <i class="fa-solid fa-sliders text-gray-500"></i>
                <select name="category" onchange="this.form.submit()"
                        class="border border-gray-200 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4A3728]">
                    <option value="">ทุกหมวดหมู่</option>
                    <option value="backpack" selected="@(Context.Request.Query["category"] == "backpack")">กระเป๋าเป้
                    </option>
                    <option value="tent" selected="@(Context.Request.Query["category"] == "tent")">เต็นท์</option>
                    <option value="shoes" selected="@(Context.Request.Query["category"] == "shoes")">รองเท้า</option>
                    <option value="cooking" selected="@(Context.Request.Query["category"] == "cooking")">อุปกรณ์ทำอาหาร
                    </option>
                    <option value="lighting" selected="@(Context.Request.Query["category"] == "lighting")">
                        ไฟฉาย/แสงสว่าง</option>
                    </select>
                </div>

                <div class="relative w-full sm:w-40">
                    <i class="fa-solid fa-tag absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
                    <input type="number" name="maxPrice" value="@Context.Request.Query["maxPrice"]" placeholder="ราคาสูงสุด"
                           class="w-full border border-gray-200 pl-10 pr-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#4A3728]" />
                </div>

                <a asp-action="Index" class="text-sm text-gray-500 hover:text-black transition">ล้างตัวกรอง</a>
        
                <button type="submit" class="hidden"></button>
            </form>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            @foreach (var item in Model)
            {
                <div
                    class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 border border-gray-100 flex flex-col h-full">
                    <div class="relative bg-gray-200 h-72 m-auto object-cover rounded-lg">
                        @if (item.ProductImages != null && item.ProductImages.Any())
                        {
                            <img src="@item.ProductImages.First().ImageUrl" class="w-full h-full object-cover" alt="@item.Name">
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center text-gray-400">ไม่มีรูปภาพ</div>
                        }
                    </div>

                    <div class="p-4 flex-grow">
                        <h3 class="font-bold text-lg text-gray-800 truncate">@item.Name</h3>
                        <p class="text-sm text-gray-500 mb-2 line-clamp-2">@item.Brand</p>

                        <div class="flex items-center gap-1 mt-1 text-sm mb-2">
                            <i class="fa-solid fa-star text-yellow-400"></i>
    
                            <span class="font-medium text-gray-700">
                                @item.Rating.ToString("F2")
                            </span>
    
                            <span class="text-gray-400 text-xs">
                                (@item.ReviewCount)
                            </span>
                        </div>
                    
                        <div class="flex justify-between items-center mt-auto">
                            <div>
                                <span class="text-sm font-bold text-green-700">฿@item.PricePerDay</span>
                                <span class="text-xs text-gray-400">/ วัน</span>
                            </div>
                        
                            <a asp-action="Details" asp-route-id="@item.Id"
                                   class="bg-[#4A3728] text-white px-4 py-2 rounded-xl text-sm font-medium hover:bg-black transition">
                                ดูรายละเอียด
                            </a>
                        </div>
                        <div class="flex justify-end">
                            <p class="text-xs mt-1 @(item.Stock == 0 ? "text-red-500 font-bold" : "text-gray-600")">
                                @if (item.Stock == 0)
                                {
                                    <span>สินค้าหมด</span>
                                }
                                else
                                {
                                    <span>คงเหลือ: @item.Stock ชิ้น</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>